<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Sign In With Koditon</title>
  <style>
    :root {
      --page-bg: #f5f5f7;
      --text-primary: #1d1d1f;
      --text-secondary: #6e6e73;
      --card-bg: rgba(255, 255, 255, 0.86);
      --card-border: rgba(255, 255, 255, 0.72);
      --shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      --site-gradient:
        radial-gradient(1000px 560px at 0% 0%, rgba(255, 255, 255, 0.72), transparent 62%),
        radial-gradient(900px 540px at 100% 0%, rgba(237, 242, 255, 0.72), transparent 64%),
        linear-gradient(180deg, #f8f8fa 0%, #f3f4f7 48%, #f5f6f8 100%);
      color-scheme: light;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      min-height: 100svh;
      min-height: 100dvh;
    }

    body {
      font-family: "SF Pro Display", "SF Pro Text", "Helvetica Neue", sans-serif;
      color: var(--text-primary);
      position: relative;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -1;
      background-image: var(--site-gradient);
      background-repeat: no-repeat;
      background-size: cover;
      pointer-events: none;
    }

    .page {
      max-width: 720px;
      margin: 0 auto;
      min-height: 100vh;
      min-height: 100svh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem calc(1rem + env(safe-area-inset-right)) calc(1rem + env(safe-area-inset-bottom)) calc(1rem + env(safe-area-inset-left));
    }

    .card {
      width: 100%;
      max-width: 560px;
      border-radius: 24px;
      padding: 1.25rem;
      border: 1px solid var(--card-border);
      background: var(--card-bg);
      box-shadow: var(--shadow);
      backdrop-filter: blur(10px) saturate(1.02);
      text-align: center;
    }

    h1 {
      margin: 0 0 0.55rem;
      font-size: clamp(1.9rem, 5vw, 2.6rem);
      line-height: 1.02;
      letter-spacing: -0.04em;
    }

    p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.45;
    }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.65rem;
      min-height: 44px;
      margin-top: 1rem;
      padding: 0.58rem 0.95rem 0.58rem 0.72rem;
      border-radius: 999px;
      text-decoration: none;
      color: #274374;
      background:
        radial-gradient(120% 140% at 0% 0%, rgba(255, 233, 242, 0.88), transparent 52%),
        radial-gradient(120% 140% at 100% 0%, rgba(225, 235, 255, 0.92), transparent 54%),
        linear-gradient(180deg, rgba(239, 244, 255, 0.98), rgba(228, 236, 252, 0.96));
      border: 1px solid rgba(167, 173, 241, 0.34);
      box-shadow: 0 8px 18px rgba(131, 136, 239, 0.14);
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .button img {
      width: 20px;
      height: 20px;
      display: block;
      border-radius: 5px;
      flex: 0 0 auto;
    }

    .hint {
      margin-top: 0.85rem;
      font-size: 0.92rem;
    }

    .desktop-hint {
      display: none;
      margin-top: 1rem;
      padding-top: 0.95rem;
      border-top: 1px solid rgba(0, 0, 0, 0.06);
      font-size: 0.94rem;
    }
  </style>
</head>
<body>
  <main class="page">
    <section class="card">
      <h1>Sign in with Koditon</h1>
      <p id="primary-copy">Continue this sign-in in the Koditon app.</p>
      <a class="button" id="open-app" href="{{.OpenURL}}" hidden>
        <img src="/koditon.svg" alt="" aria-hidden="true" />
        <span>Sign in with Koditon</span>
      </a>
      <p class="hint" id="ios-hint" hidden>If the app does not open automatically, use the button above.</p>
      <p class="desktop-hint" id="desktop-hint">
        This link opens the Koditon app on iPhone or iPad. Return to the previous screen and use your phone to scan the QR code or enter the sign-in code shown there.
      </p>
    </section>
  </main>
  <script>
    {{template "userAgentHelper" .}}
    const openApp = document.getElementById('open-app');
    const iosHint = document.getElementById('ios-hint');
    const desktopHint = document.getElementById('desktop-hint');
    const primaryCopy = document.getElementById('primary-copy');
    const context = detectKoditonUserAgentContext();

    openApp.hidden = false;

    if (context.isLikelyIOS) {
      iosHint.hidden = false;
      window.location.href = openApp.href;
    } else {
      desktopHint.style.display = 'block';
      primaryCopy.textContent = 'If Koditon is installed on this device, try the button above. Otherwise use your phone to continue this sign-in in the Koditon app.';
    }
  </script>
</body>
</html>
