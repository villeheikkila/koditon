# Encrypt this file with ansible-vault before use.

infra_env:
  CADDY_EMAIL: ""
  POSTGRES_PASSWORD: ""
  PRICES_BASE_URL: ""
  SHORTCUT_BASE_URL: ""
  SHORTCUT_DOCS_BASE_URL: ""
  SHORTCUT_AD_BASE_URL: ""
  SHORTCUT_USER_AGENT: ""
  SHORTCUT_SITEMAP_BASE_URL: ""
  FRONTDOOR_BASE_URL: ""
  FRONTDOOR_USER_AGENT: ""
  FRONTDOOR_COOKIE: ""
  FRONTDOOR_SITEMAP_BASE_URL: ""
  OPENROUTER_API_KEY: ""
  TELEGRAM_BOT_TOKEN: ""
  TELEGRAM_CHAT_ID: ""
  # Generate with: openssl rand -hex 32
  AUTH_JWT_SIGNING_KEY: ""
  AUTH_JWT_ISSUER: ""
  # Apple auth (optional)
  AUTH_APPLE_BUNDLE_ID: ""
  AUTH_APPLE_TEAM_ID: ""
  AUTH_APPLE_PRIVATE_KEY_ID: ""
  AUTH_APPLE_PRIVATE_KEY: ""

# Optional: set deploy user's Unix password hash.
# Generate with: openssl passwd -6
deploy_password_hash: ""
