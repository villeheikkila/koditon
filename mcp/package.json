{
  "name": "@koditon/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "koditon-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:app",
    "build:app": "vite build",
    "build:server": "tsc -p tsconfig.json",
    "dev": "concurrently --names server,app --prefix-colors blue,green \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "vite build --watch --clearScreen false",
    "dev:mcp": "node dist/index.js",
    "dev:server": "tsc -p tsconfig.json --watch --preserveWatchOutput false",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "vite": "^8.1.0",
    "vite-plugin-singlefile": "^2.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
